{
  "name": "urbe-engine",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assemble": "tsx src/assembly/cli.js",
    "assemble-city": "tsx src/assembly/city-cli.js",
    "simulate": "tsx src/assembly/simulate-cli.js",
    "carry-quests": "tsx src/assembly/quests-cli.js",
    "install-character-assets": "node scripts/install-character-assets.mjs",
    "audit-character-assets": "node scripts/install-character-assets.mjs --check",
    "speech-install": "uv sync --project src/game/voice/runtime --frozen",
    "speech-health": "uv run --project src/game/voice/runtime --frozen python src/game/voice/runtime/service.py health",
    "speech-smoke": "uv run --project src/game/voice/runtime --frozen python src/game/voice/runtime/service.py smoke",
    "test:speech-runtime": "uv run --project src/game/voice/runtime --frozen python -m unittest discover -s src/game/voice/runtime -p 'test_*.py'",
    "test": "npm run test:speech-runtime && vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "meshoptimizer": "1.2.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.6",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}

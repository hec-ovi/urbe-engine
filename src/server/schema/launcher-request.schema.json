{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:server:launcher-request",
  "title": "Launcher route request",
  "oneOf": [
    {
      "type": "object",
      "required": ["method"],
      "properties": { "method": { "const": "catalog" } },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "enum": ["continueGame", "exportGame", "exportCity"] },
        "input": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "const": "importGame" },
        "input": { "$ref": "urn:urbe:engine:library:game-descriptor" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "const": "generateCity" },
        "input": { "$ref": "urn:urbe:engine:creation:generate-city" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "const": "generateInstances" },
        "input": { "$ref": "urn:urbe:engine:creation:generate-instances" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "const": "generateQuests" },
        "input": { "$ref": "urn:urbe:engine:creation:generate-quests" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "const": "createGame" },
        "input": { "$ref": "urn:urbe:engine:creation:create-game" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["method", "input"],
      "properties": {
        "method": { "const": "saveCurrent" },
        "input": { "$ref": "urn:urbe:engine:game-persistence:save-current-payload" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:server:voice-prefetch-response",
  "description": "The Voice cache key of each prefetched line, in item order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys"],
  "properties": {
    "keys": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
  }
}

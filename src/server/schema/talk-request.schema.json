{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:server:talk-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["out", "npc", "behavior", "line", "timeMin"],
  "properties": {
    "out": { "type": "string", "pattern": "^/out(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$" },
    "npc": { "$ref": "#/$defs/npc" },
    "behavior": { "$ref": "#/$defs/behavior" },
    "line": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "timeMin": { "type": "number" },
    "quests": {
      "type": "array",
      "items": { "$ref": "#/$defs/quest" }
    },
    "offers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "follow": { "type": "boolean" },
        "walk": { "type": "boolean" },
        "stop": { "type": "boolean" },
        "home": { "type": "boolean" },
        "work": { "type": "boolean" },
        "wait": { "type": "boolean" },
        "sit": { "type": "boolean" },
        "contact": { "description": "The person may give the player their number.", "type": "boolean" },
        "meet": {
          "description": "On a call, the person may come to where the player is: that place as the player knows it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1 } }
        },
        "give": {
          "description": "Access cards the person may hand the player a copy of: each by its item id and what the player reads it as.",
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["itemId", "name"],
                "properties": { "itemId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1, "maxLength": 400 } }
              }
            }
          }
        },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placeId", "name"],
            "properties": {
              "placeId": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "prior": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "text", "atMin"],
        "properties": {
          "speaker": { "enum": ["player", "npc"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "atMin": { "type": "number" }
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeId", "kind"],
      "properties": {
        "placeId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["parcel", "stop", "street", "person", "spot"] },
        "name": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    },
    "events": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/event" } },
    "look": {
      "description": "What the person looks like, in words taken from the recipe the game draws them in.",
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "build", "face", "hair", "skin", "eyes", "wearing"],
      "properties": {
        "height": { "$ref": "#/$defs/words" },
        "build": { "$ref": "#/$defs/words" },
        "face": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/words" } },
        "hair": { "$ref": "#/$defs/words" },
        "skin": { "$ref": "#/$defs/words" },
        "eyes": { "$ref": "#/$defs/words" },
        "wearing": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/words" } },
        "fabric": { "$ref": "#/$defs/words" }
      }
    },
    "people": {
      "description": "Who the person knows and where they are now, and the names the player asked about that the person does not know (quests peopleKnown).",
      "type": "object",
      "additionalProperties": false,
      "required": ["known", "unknown"],
      "properties": {
        "known": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/knownPerson" } },
        "unknown": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/words" } }
      }
    },
    "call": {
      "description": "The player is not with the person but called them: they talk on the phone.",
      "type": "object",
      "additionalProperties": false,
      "required": ["caller"],
      "properties": { "caller": { "const": "player" } }
    },
    "addresses": {
      "description": "Where the person lives and works by address, where inside a furnished building they stand now, the access cards they carry and how often they caught the player lifting one (Quests DialogAddresses).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": { "$ref": "#/$defs/address" },
        "work": { "$ref": "#/$defs/address" },
        "here": { "$ref": "#/$defs/address" },
        "access": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parcelId", "opens"],
            "properties": {
              "parcelId": { "$ref": "#/$defs/id" },
              "opens": { "$ref": "#/$defs/words" },
              "tie": { "enum": ["home", "work"] }
            }
          }
        },
        "caught": { "type": "integer", "minimum": 0 }
      }
    },
    "task": {
      "description": "What the person is doing for the player now: following, leading to a place, or an errand the player asked for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["following", "leading", "brought", "walking", "waiting", "sitting", "home", "work"] },
        "place": { "$ref": "#/$defs/words" }
      }
    },
    "here": {
      "description": "Where the person stands: world XZ, the building and floor they are inside, the light there.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" },
        "parcelId": { "$ref": "#/$defs/id" },
        "floor": { "type": "integer", "minimum": 0 },
        "light": { "$ref": "#/$defs/words" },
        "building": {
          "description": "The building the person stands in: what each floor holds, its lifts and staircases, the room they are in and who is inside.",
          "type": "object",
          "additionalProperties": false,
          "required": ["floors", "lifts", "stairs"],
          "properties": {
            "floors": {
              "type": "array", "maxItems": 120,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["index", "rooms"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "rooms": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/words" } },
                  "apartments": { "type": "array", "maxItems": 99, "items": { "$ref": "#/$defs/words" } }
                }
              }
            },
            "room": { "$ref": "#/$defs/words" },
            "lifts": { "type": "integer", "minimum": 0 },
            "stairs": { "type": "integer", "minimum": 0 },
            "people": {
              "type": "array", "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["role", "floor"],
                "properties": {
                  "name": { "$ref": "#/$defs/words" },
                  "role": { "$ref": "#/$defs/words" },
                  "floor": { "type": "integer", "minimum": 0 },
                  "room": { "$ref": "#/$defs/words" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "address": {
      "description": "A place by its address: the building, the floor as its numbers count it (0 the ground floor), and the dwelling or private room and the kind of room on it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["parcelId"],
      "properties": {
        "parcelId": { "$ref": "#/$defs/id" },
        "floor": { "type": "integer" },
        "unit": { "$ref": "#/$defs/words" },
        "room": { "$ref": "#/$defs/words" }
      }
    },
    "words": { "type": "string", "minLength": 1, "maxLength": 200 },
    "knownPerson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npcId", "name", "relation", "now"],
      "properties": {
        "npcId": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "relation": { "enum": ["coworker", "household", "neighbour"] },
        "kin": { "enum": ["partner", "child", "parent", "sibling", "roommate"] },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place", "role", "days", "startMin", "endMin"],
          "properties": {
            "place": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": { "kind": { "enum": ["parcel", "stop"] }, "id": { "$ref": "#/$defs/id" } }
            },
            "role": { "$ref": "#/$defs/id" },
            "days": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "uniqueItems": true },
            "startMin": { "type": "number" },
            "endMin": { "type": "number" }
          }
        },
        "now": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": { "kind": { "enum": ["here", "home", "street", "transit", "unknown"] } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "place"],
              "properties": {
                "kind": { "const": "place" },
                "place": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "id"],
                  "properties": { "kind": { "enum": ["parcel", "stop"] }, "id": { "$ref": "#/$defs/id" } }
                }
              }
            }
          ]
        },
        "asked": { "type": "boolean" }
      }
    },
    "event": {
      "description": "Something the game saw happen near the conversation: a car hitting someone by a building, or a quest scene standing there.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "atMin", "parcelId", "metres"],
          "properties": {
            "kind": { "const": "struck" },
            "atMin": { "type": "number", "minimum": 0 },
            "parcelId": { "$ref": "#/$defs/id" },
            "metres": { "type": "number", "minimum": 0 },
            "hard": { "type": "boolean" },
            "self": { "type": "boolean" },
            "down": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "atMin", "parcelId", "metres", "notes"],
          "properties": {
            "kind": { "const": "scene" },
            "atMin": { "type": "number", "minimum": 0 },
            "parcelId": { "$ref": "#/$defs/id" },
            "metres": { "type": "number", "minimum": 0 },
            "notes": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
          }
        }
      ]
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["given", "family"],
      "properties": {
        "given": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["edge", "stop", "parcel", "route"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "activity": {
      "enum": ["sleeping", "home", "working", "commuting", "shopping", "leisure", "transit_wait"]
    },
    "shift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMin", "endMin", "days", "kind"],
      "properties": {
        "startMin": { "type": "number" },
        "endMin": { "type": "number" },
        "days": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 },
          "uniqueItems": true
        },
        "kind": { "enum": ["day", "evening", "night", "rotating"] }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parcelId", "role", "shift"],
      "properties": {
        "parcelId": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "shift": { "$ref": "#/$defs/shift" }
      }
    },
    "transitJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "role", "shift"],
      "properties": {
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["stop", "route"] },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        "role": { "$ref": "#/$defs/id" },
        "shift": { "$ref": "#/$defs/shift" }
      }
    },
    "familyMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npcId", "relation", "name", "instantiated"],
      "properties": {
        "npcId": { "$ref": "#/$defs/id" },
        "relation": { "enum": ["partner", "child", "parent", "sibling", "roommate"] },
        "name": { "$ref": "#/$defs/name" },
        "instantiated": { "type": "boolean" }
      }
    },
    "pathEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "direction", "path3", "distanceM"],
      "properties": {
        "edgeId": { "$ref": "#/$defs/id" },
        "direction": { "enum": [-1, 1] },
        "path3": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "distanceM": { "type": "number", "minimum": 0 }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "startMin", "endMin", "activity", "place"],
      "properties": {
        "days": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 },
          "uniqueItems": true
        },
        "startMin": { "type": "number" },
        "endMin": { "type": "number" },
        "activity": { "$ref": "#/$defs/activity" },
        "place": { "$ref": "#/$defs/place" },
        "walk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "edges", "totalDistanceM"],
          "properties": {
            "from": { "$ref": "#/$defs/place" },
            "to": { "$ref": "#/$defs/place" },
            "edges": { "type": "array", "items": { "$ref": "#/$defs/pathEdge" } },
            "totalDistanceM": { "type": "number", "minimum": 0 }
          }
        },
        "transitLeg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routeId", "boardStopId", "alightStopId"],
          "properties": {
            "routeId": { "$ref": "#/$defs/id" },
            "boardStopId": { "$ref": "#/$defs/id" },
            "alightStopId": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npcId", "name", "gender", "appearanceSeed", "type", "home", "family", "routine", "flags"],
      "properties": {
        "npcId": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "gender": { "enum": ["male", "female"] },
        "age": { "type": "integer", "minimum": 0 },
        "traits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "maxItems": 8
        },
        "appearanceSeed": { "type": "integer" },
        "type": { "$ref": "#/$defs/id" },
        "home": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parcelId", "unit"],
          "properties": {
            "parcelId": { "$ref": "#/$defs/id" },
            "unit": { "type": "integer", "minimum": 0 },
            "apartment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "floor"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "floor": { "type": "integer", "minimum": 0 },
                "number": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "job": { "$ref": "#/$defs/job" },
        "transitJob": { "$ref": "#/$defs/transitJob" },
        "family": { "type": "array", "items": { "$ref": "#/$defs/familyMember" } },
        "routine": { "type": "array", "items": { "$ref": "#/$defs/routine" } },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dead", "custom"],
          "properties": {
            "dead": { "type": "boolean" },
            "custom": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
          }
        }
      }
    },
    "interior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at"],
          "properties": {
            "at": {
              "type": "object",
              "additionalProperties": false,
              "required": ["anchorId", "animation", "untilMin"],
              "properties": {
                "anchorId": { "$ref": "#/$defs/id" },
                "animation": {
                  "enum": ["idle_stand", "idle_sit", "idle_lean", "work_type", "work_serve", "work_cook", "sweep", "patrol_stand", "exercise", "sleep", "use_toilet"]
                },
                "untilMin": { "type": "number" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["walk"],
          "properties": {
            "walk": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fromAnchorId", "toAnchorId"],
              "properties": {
                "fromAnchorId": { "$ref": "#/$defs/id" },
                "toAnchorId": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "activity", "place", "interrupted"],
      "properties": {
        "mode": { "enum": ["interior", "street", "transit", "home"] },
        "activity": { "$ref": "#/$defs/activity" },
        "place": { "$ref": "#/$defs/place" },
        "interior": { "$ref": "#/$defs/interior" },
        "interrupted": { "type": "boolean" }
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cast", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cast": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/id" }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activeStepIds", "completedStepIds", "flags"],
          "properties": {
            "activeStepIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
            "completedStepIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
            "flags": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
            "endingId": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  }
}

    "code": {"enum": ["E_INVALID_REQUEST", "E_UNAVAILABLE", "E_BUSY", "E_JOB_NOT_FOUND", "E_STORAGE", "E_BUILD_FAILED", "E_BUILD_INCOMPLETE"]},

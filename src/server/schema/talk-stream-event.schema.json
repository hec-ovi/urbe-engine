{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:server:talk-stream-event",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "delta" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "index", "text"],
      "properties": {
        "type": { "const": "sentence" },
        "index": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "enum": ["follow", "stop", "home", "work", "wait", "sit", "contact"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "name"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "const": "meet" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "itemId", "name"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "const": "give" },
        "itemId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "itemId", "name"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "const": "take" },
        "itemId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "itemId", "name", "price"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "const": "sell" },
        "itemId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "itemId", "name", "amount"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "const": "buy" },
        "itemId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "amount"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "enum": ["pay", "accept", "ask"] },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "placeId", "name"],
      "properties": {
        "type": { "const": "offer" },
        "kind": { "enum": ["lead", "walk"] },
        "placeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reply"],
      "properties": {
        "type": { "const": "done" },
        "reply": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "error"],
      "properties": {
        "type": { "const": "error" },
        "error": { "type": "string", "minLength": 1 }
      }
    }
  ]
}

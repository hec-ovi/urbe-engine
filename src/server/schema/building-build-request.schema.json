{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/engine/building-build-request",
  "title": "BuildingBuildRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["parcel", "out"],
  "properties": {
    "parcel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "out": {
      "type": "string",
      "pattern": "^/out(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,63})?$"
    }
  }
}

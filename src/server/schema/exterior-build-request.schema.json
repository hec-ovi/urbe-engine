{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/engine/exterior-build-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint"],
  "properties": {
    "blueprint": {
      "type": "object",
      "required": ["meta", "parcels", "streets", "districts", "blocks", "transit", "volumetric", "stats"],
      "properties": {
        "meta": {"type": "object", "required": ["seed", "version"], "properties": {"seed": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
        "parcels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}}}},
        "streets": {"type": "object"},
        "districts": {"type": "array"},
        "blocks": {"type": "array"},
        "transit": {"type": "object"},
        "volumetric": {"type": "object"},
        "stats": {"type": "object"}
      }
    }
  }
}

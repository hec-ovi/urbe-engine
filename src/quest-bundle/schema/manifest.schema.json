{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:quest-bundle:manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "files", "counts"],
  "properties": {
    "contractVersion": { "enum": ["1.1", "1.2"] },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questlines", "objectives", "investigations", "mechanicTargetBindings", "missionAssetRequests", "missionItemBindings", "hostCapabilities"],
      "properties": {
        "questlines": { "$ref": "#/$defs/file" },
        "objectives": { "const": "objectives.json" },
        "investigations": { "const": "investigations.json" },
        "mechanicTargetBindings": { "const": "mechanic-target-bindings.json" },
        "missionAssetRequests": { "const": "mission-assets.json" },
        "missionItemBindings": { "const": "mission-item-bindings.json" },
        "scenery": { "const": "scenery.json" },
        "hostCapabilities": { "const": "host-capabilities.json" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questlines", "objectives", "investigations", "mechanicTargetBindings", "missionAssetRequests", "missionItemBindings"],
      "properties": {
        "questlines": { "$ref": "#/$defs/count" },
        "objectives": { "$ref": "#/$defs/count" },
        "investigations": { "$ref": "#/$defs/count" },
        "mechanicTargetBindings": { "$ref": "#/$defs/count" },
        "missionAssetRequests": { "$ref": "#/$defs/count" },
        "missionItemBindings": { "$ref": "#/$defs/count" },
        "scenery": { "$ref": "#/$defs/count" }
      }
    }
  },
  "if": { "properties": { "contractVersion": { "const": "1.2" } }, "required": ["contractVersion"] },
  "then": {
    "properties": {
      "files": { "type": "object", "properties": { "scenery": {} }, "required": ["scenery"] },
      "counts": { "type": "object", "properties": { "scenery": {} }, "required": ["scenery"] }
    }
  },
  "else": {
    "properties": {
      "files": { "type": "object", "not": { "properties": { "scenery": {} }, "required": ["scenery"] } },
      "counts": { "type": "object", "not": { "properties": { "scenery": {} }, "required": ["scenery"] } }
    }
  },
  "$defs": {
    "file": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+\\.json$" },
    "count": { "type": "integer", "minimum": 0 }
  }
}

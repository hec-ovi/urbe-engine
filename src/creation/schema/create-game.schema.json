{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:creation:create-game",
  "type": "object",
  "required": ["cityId", "interiorIds", "questId"],
  "properties": {
    "cityId": { "$ref": "#/$defs/id" },
    "interiorIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "questId": { "$ref": "#/$defs/id" }
  },
  "additionalProperties": false,
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" } }
}

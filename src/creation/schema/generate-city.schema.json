{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:creation:generate-city",
  "type": "object",
  "required": ["size"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "size": { "enum": ["small", "medium", "large"] },
    "districtCount": { "$ref": "#/$defs/districtCount" },
    "features": { "$ref": "#/$defs/features" }
  },
  "additionalProperties": false,
  "$defs": {
    "districtCount": {
      "description": "Atlas `districtCount`: the inclusive [min, max] district range, min <= max. Omitted, Atlas scales it with the city's area.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/districts" }, { "$ref": "#/$defs/districts" }],
      "minItems": 2,
      "items": false
    },
    "districts": { "type": "integer", "minimum": 1, "maximum": 12 },
    "features": {
      "description": "Atlas `features` toggles: false is `--no-<feature>`. An omitted toggle, or true, keeps Atlas's default, on.",
      "type": "object",
      "properties": {
        "highways": { "type": "boolean" },
        "subways": { "type": "boolean" },
        "alleys": { "type": "boolean" }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}

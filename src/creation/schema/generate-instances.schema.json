{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:creation:generate-instances",
  "type": "object",
  "required": ["cityId", "mode", "count", "buildingIds"],
  "properties": {
    "cityId": { "$ref": "#/$defs/id" },
    "mode": { "enum": ["automatic", "manual"] },
    "count": { "type": "integer", "minimum": 1, "maximum": 24 },
    "buildingIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "manual" } } },
      "then": { "properties": { "buildingIds": { "type": "array", "minItems": 1 } } }
    }
  ],
  "additionalProperties": false,
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" } }
}

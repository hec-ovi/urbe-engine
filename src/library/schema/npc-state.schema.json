{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:library:npc-state",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeMin", "simulation", "continuity"],
  "properties": {
    "timeMin": { "type": "number", "minimum": 0 },
    "simulation": { "$ref": "urn:urbe:simulation:save" },
    "continuity": { "$ref": "urn:urbe:engine:npc-agents:continuity-save" }
  }
}

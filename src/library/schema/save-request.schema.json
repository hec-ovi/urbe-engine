{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:library:save-request",
  "title": "Game save request",
  "type": "object",
  "required": ["game", "expectedRevision"],
  "properties": {
    "game": {
      "$ref": "urn:urbe:engine:library:game-descriptor"
    },
    "expectedRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}

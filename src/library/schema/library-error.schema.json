{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:library:library-error",
  "title": "Library error",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        "E_INVALID_REQUEST",
        "E_INVALID_ID",
        "E_CITY_NOT_FOUND",
        "E_GAME_NOT_FOUND",
        "E_INVALID_DESCRIPTOR",
        "E_REFERENCE_NOT_FOUND",
        "E_REVISION_CONFLICT",
        "E_EXISTS",
        "E_UNSAFE_PATH",
        "E_STORAGE"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

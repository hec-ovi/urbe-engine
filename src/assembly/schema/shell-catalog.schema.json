{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/engine/shell-catalog",
  "title": "Source-derived shell streaming catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [ "version", "seed", "buildings" ],
  "properties": {
    "version": { "const": "1.0.0" },
    "seed": { "type": "string", "minLength": 1 },
    "buildings": { "type": "array", "items": { "$ref": "#/$defs/building" } }
  },
  "$defs": {
    "point2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "point3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "outline": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point2" } },
    "material": {
      "type": "object", "additionalProperties": false, "required": [ "key", "variantId" ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_-]+$" },
        "variantId": { "type": "string", "minLength": 1 }
      }
    },
    "band": {
      "type": "object", "additionalProperties": false, "required": [ "bottom", "top", "outline", "material" ],
      "properties": {
        "bottom": { "type": "number", "minimum": 0 },
        "top": { "type": "number", "exclusiveMinimum": 0 },
        "outline": { "$ref": "#/$defs/outline" },
        "material": { "$ref": "#/$defs/material" }
      }
    },
    "building": {
      "type": "object", "additionalProperties": false,
      "required": [ "id", "bounds", "center", "floorCount", "basementCount", "bands", "roof" ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bounds": {
          "type": "object", "additionalProperties": false, "required": [ "min", "max" ],
          "description": "AABB of Exterior's published massing footprint and parapet height, not rooftop equipment.",
          "properties": { "min": { "$ref": "#/$defs/point3" }, "max": { "$ref": "#/$defs/point3" } }
        },
        "center": { "$ref": "#/$defs/point3", "description": "Exterior footprint vertex average on Y=0, for horizontal proximity." },
        "floorCount": { "type": "integer", "minimum": 1, "description": "Number of authored floors with index >= 0." },
        "basementCount": { "type": "integer", "minimum": 0 },
        "bands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/band" } },
        "roof": {
          "type": "object", "additionalProperties": false,
          "required": [ "elevation", "outline", "parapetHeight", "material", "parapetMaterial" ],
          "properties": {
            "elevation": { "type": "number", "exclusiveMinimum": 0 },
            "outline": { "$ref": "#/$defs/outline" },
            "parapetHeight": { "type": "number", "minimum": 0 },
            "material": { "$ref": "#/$defs/material" },
            "parapetMaterial": { "$ref": "#/$defs/material", "description": "The published concrete material-plan field." }
          }
        }
      }
    }
  }
}

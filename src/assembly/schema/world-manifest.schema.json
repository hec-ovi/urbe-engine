{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/engine/world-manifest",
  "title": "Engine assembled world manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [ "contractVersion", "seed", "atlasVersion", "named", "namingTheme", "parcels", "interiors", "floors" ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "seed": { "type": "string", "minLength": 1 },
    "atlasVersion": { "type": "string", "minLength": 1 },
    "named": { "type": "boolean" },
    "namingTheme": { "type": [ "string", "null" ] },
    "parcels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/parcelId" }
    },
    "interiors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/parcelId" }
    },
    "floors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/parcelId" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^-?[0-9]{3}$" }
      }
    },
    "rooftopSpans": { "$ref": "../connections/rooftop-span-output" },
    "blueprint": { "$ref": "#/$defs/archiveBlueprint" },
    "shellCatalog": {
      "type": "object", "additionalProperties": false, "required": [ "file", "encoding", "sha256" ],
      "properties": {
        "file": { "const": "shells/index.json" },
        "encoding": { "const": "archive" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "kit": {
      "type": "object", "additionalProperties": false, "required": [ "file", "sha256" ],
      "description": "The piece kit this world was built from, in the shared store, present when any parcel was assembled from it.",
      "properties": {
        "file": { "const": "kit.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "shared": { "$ref": "#/$defs/sharedSet" }
      }
    },
    "interiorModules": {
      "type": "object", "additionalProperties": false, "required": [ "file", "sha256" ],
      "description": "The shared interior module set, present when any building is furnished.",
      "properties": {
        "file": { "const": "modules.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "shared": { "$ref": "#/$defs/sharedSet" }
      }
    },
    "interiorProps": {
      "type": "object", "additionalProperties": false, "required": [ "file", "sha256" ],
      "description": "The furniture catalog beside the module set, with the models it names.",
      "properties": {
        "file": { "const": "catalog.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "shared": { "$ref": "#/$defs/sharedSet" }
      }
    },
    "sources": {
      "type": "object",
      "description": "How each parcel is drawn: its own GLB, the kit pieces, or nothing at all.",
      "propertyNames": { "$ref": "#/$defs/parcelId" },
      "additionalProperties": { "enum": [ "kit", "shell", "empty" ] }
    },
    "buildings": {
      "type": "object",
      "description": "What each kit parcel stands from: the Atlas block template and lot slot it was dressed by, and the building plan its pieces come from.",
      "propertyNames": { "$ref": "#/$defs/parcelId" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": [ "template", "slot", "plan" ],
        "properties": {
          "template": {
            "type": [ "string", "null" ],
            "description": "meta.blockTemplates id, or null for a block Atlas tiled on its own."
          },
          "slot": { "type": [ "integer", "null" ], "minimum": 0 },
          "plan": { "type": "string", "minLength": 1, "description": "kit/plans/<plan>.json" },
          "blueprint": {
            "enum": [ "plan", "parcel" ],
            "description": "Where this building's blueprint is read from: composed from kit/plans/<plan>.blueprint.json, or the parcel's own <parcel>.blueprint.json, which is also what a world written before the document moved to the plan holds. Absent means the parcel's own."
          }
        }
      }
    },
    "streets": {
      "type": "object", "additionalProperties": false, "required": [ "file", "sha256", "kitSha256", "blueprintSha256" ],
      "description": "The street bundle: its manifest, the shared piece kit beside it, and the blueprint both were built from.",
      "properties": {
        "file": { "const": "streets/manifest.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kitSha256": { "$ref": "#/$defs/sha256" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" },
        "sharedKit": { "$ref": "#/$defs/sharedSet" }
      }
    },
    "connections": {
      "oneOf": [
        { "$ref": "#/$defs/jsonConnections" },
        { "$ref": "#/$defs/archiveConnections" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [ "connections" ],
        "properties": { "connections": { "type": "object", "required": [ "encoding" ] } }
      },
      "then": { "required": [ "blueprint" ] }
    },
    {
      "if": { "required": [ "blueprint" ] },
      "then": { "properties": { "connections": { "$ref": "#/$defs/archiveConnections" } } }
    },
    { "if": { "required": [ "streets" ] }, "then": { "not": { "required": [ "blueprint" ] } } }
  ],
  "$defs": {
    "parcelId": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sharedSet": {
      "type": "string",
      "pattern": "^[a-z-]+/[0-9a-f]{16}$",
      "description": "Where this set stands in the shared store, under /out/shared. Absent for a world that carries its own copy."
    },
    "jsonConnections": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "sha256", "blueprintSha256" ],
      "properties": {
        "file": { "const": "connections.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archiveBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "encoding", "sha256" ],
      "properties": {
        "file": { "const": "blueprint/index.json" },
        "encoding": { "const": "archive" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archiveConnections": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "encoding", "sha256", "blueprintSha256" ],
      "properties": {
        "file": { "const": "connections/index.json" },
        "encoding": { "const": "archive" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

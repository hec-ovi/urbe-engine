{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/engine/world-manifest",
  "title": "Engine assembled world manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [ "contractVersion", "seed", "atlasVersion", "named", "namingTheme", "parcels", "interiors", "floors" ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "seed": { "type": "string", "minLength": 1 },
    "atlasVersion": { "type": "string", "minLength": 1 },
    "named": { "type": "boolean" },
    "namingTheme": { "type": [ "string", "null" ] },
    "parcels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/parcelId" }
    },
    "interiors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/parcelId" }
    },
    "floors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/parcelId" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^-?[0-9]{3}$" }
      }
    },
    "rooftopSpans": { "$ref": "../connections/rooftop-span-output" },
    "blueprint": { "$ref": "#/$defs/archiveBlueprint" },
    "connections": {
      "oneOf": [
        { "$ref": "#/$defs/jsonConnections" },
        { "$ref": "#/$defs/archiveConnections" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [ "connections" ],
        "properties": { "connections": { "required": [ "encoding" ] } }
      },
      "then": { "required": [ "blueprint" ] }
    },
    {
      "if": { "required": [ "blueprint" ] },
      "then": { "properties": { "connections": { "$ref": "#/$defs/archiveConnections" } } }
    }
  ],
  "$defs": {
    "parcelId": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "jsonConnections": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "sha256", "blueprintSha256" ],
      "properties": {
        "file": { "const": "connections.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archiveBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "encoding", "sha256" ],
      "properties": {
        "file": { "const": "blueprint/index.json" },
        "encoding": { "const": "archive" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archiveConnections": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "encoding", "sha256", "blueprintSha256" ],
      "properties": {
        "file": { "const": "connections/index.json" },
        "encoding": { "const": "archive" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "blueprintSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

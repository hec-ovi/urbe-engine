{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/engine/kit-plan",
  "title": "Kit building plan",
  "description": "One building the city repeats: every piece of it at the world origin, face 0 running along +X. A parcel that stands from this plan names it by id and carries only its own frame.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "baysAcross",
    "baysDeep",
    "floors",
    "bands",
    "pieces",
    "placements",
    "signAnchors",
    "doors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "family, bays across, bays deep and floors: the four things that decide where every piece goes."
    },
    "family": {
      "$ref": "https://urbe.dev/exterior/placement.schema.json#/properties/family"
    },
    "baysAcross": {
      "type": "integer",
      "minimum": 2,
      "description": "Bays along face 0: an edge of 8N metres is two 4 m corner arms and N-1 straight bays, so each face places N pieces."
    },
    "baysDeep": {
      "type": "integer",
      "minimum": 2
    },
    "floors": {
      "type": "integer",
      "minimum": 2
    },
    "bands": {
      "$ref": "https://urbe.dev/exterior/placement.schema.json#/properties/bands"
    },
    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The piece files this building is made of, named once."
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "description": "One copy per entry, in the plan's own metres: which piece, which lot face it stands in, where it stands and how it is turned.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "piece",
          "face",
          "position",
          "rotationY"
        ],
        "properties": {
          "piece": {
            "type": "integer",
            "minimum": 0,
            "description": "Index into pieces."
          },
          "face": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotationY": {
            "type": "number"
          }
        }
      }
    },
    "signAnchors": {
      "$ref": "https://urbe.dev/exterior/placement.schema.json#/properties/signAnchors"
    },
    "doors": {
      "$ref": "https://urbe.dev/exterior/placement.schema.json#/properties/doors"
    }
  }
}

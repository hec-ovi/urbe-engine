{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:mission-assets:values",
  "title": "Mission asset shared values",
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,95}$"
    },
    "family": {
      "enum": [
        "document",
        "data-drive",
        "evidence-container",
        "tool",
        "control-terminal",
        "package",
        "table",
        "chair",
        "shelf",
        "cabinet"
      ]
    },
    "interaction": {
      "enum": [
        "inspect",
        "read",
        "take",
        "use",
        "open",
        "close",
        "store",
        "place-item",
        "sit",
        "access",
        "hack",
        "sabotage"
      ]
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height", "depth"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 0.001, "maximum": 12 },
        "height": { "type": "number", "minimum": 0.001, "maximum": 12 },
        "depth": { "type": "number", "minimum": 0.001, "maximum": 12 }
      }
    },
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "zeroVector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "const": 0 },
        "y": { "const": 0 },
        "z": { "const": 0 }
      }
    },
    "unitScale": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "const": 1 },
        "y": { "const": 1 },
        "z": { "const": 1 }
      }
    },
    "bounds": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/vector3" },
        "max": { "$ref": "#/$defs/vector3" }
      }
    },
    "materialAssignment": {
      "type": "object",
      "required": ["slot", "key", "variantId"],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "enum": ["surface", "accent", "display", "upholstery", "grip", "seal"]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_-]+$"
        },
        "variantId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+(:[a-z0-9_-]+)?$"
        }
      }
    },
    "mediaReference": {
      "type": "object",
      "required": ["uri", "mediaType", "byteSize", "checksum"],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^urn:urbe:mission-asset:[a-z0-9][a-z0-9._:-]+$"
        },
        "mediaType": { "const": "application/vnd.urbe.mission-asset+json" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conversation panel labels; {name} stands for the person talked to",
  "type": "object",
  "required": ["log", "from", "story", "hint", "topics", "choices", "actions", "free", "talk", "voice", "activity", "tags", "notes", "reveal", "retry", "leave", "leaveCall", "leaveKey"],
  "additionalProperties": false,
  "properties": {
    "log": { "description": "Accessible name of the transcript.", "$ref": "#/$defs/text" },
    "from": {
      "description": "Name over a line by who it is from: the player, or the scene set as a story talk opens.",
      "type": "object",
      "required": ["player", "scene"],
      "additionalProperties": false,
      "properties": { "player": { "$ref": "#/$defs/text" }, "scene": { "$ref": "#/$defs/text" } }
    },
    "story": {
      "type": "object",
      "required": ["kicker", "goal", "stake", "journal"],
      "additionalProperties": false,
      "properties": {
        "kicker": { "$ref": "#/$defs/text" },
        "goal": { "$ref": "#/$defs/text" },
        "stake": { "description": "Label of why the talk matters.", "$ref": "#/$defs/text" },
        "journal": { "$ref": "#/$defs/text" }
      }
    },
    "hint": {
      "type": "object",
      "required": [
        "title",
        "key",
        "close",
        "unread",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "close": {
          "$ref": "#/$defs/text"
        },
        "unread": {
          "$ref": "#/$defs/text"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "sections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "enum": [
                  "objective",
                  "stake",
                  "scene",
                  "hint"
                ]
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "topics": { "$ref": "#/$defs/section" },
    "choices": {
      "type": "object",
      "required": ["title", "hint", "commits"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "commits": { "description": "Marks a reply that moves the story on.", "$ref": "#/$defs/text" }
      }
    },
    "actions": { "$ref": "#/$defs/section" },
    "free": {
      "type": "object",
      "required": ["hint", "placeholder", "input", "send"],
      "additionalProperties": false,
      "properties": {
        "hint": { "$ref": "#/$defs/text" },
        "placeholder": { "$ref": "#/$defs/text" },
        "input": { "description": "Accessible name of the text box.", "$ref": "#/$defs/text" },
        "send": { "description": "Accessible name of the send button.", "$ref": "#/$defs/text" }
      }
    },
    "talk": {
      "description": "The talk window, closed until the player opens it, in the top left corner without a title: the text box, the transcript and the actions tray.",
      "type": "object",
      "required": ["open", "key", "window", "close", "actions", "back", "empty"],
      "additionalProperties": false,
      "properties": {
        "open": { "description": "The button that opens the window.", "$ref": "#/$defs/text" },
        "key": { "description": "The key that opens it while the text box is not in use.", "type": "string", "pattern": "^[A-Z]$" },
        "window": { "description": "Accessible name of the window.", "$ref": "#/$defs/text" },
        "close": { "$ref": "#/$defs/text" },
        "actions": { "description": "The window's side tab and tray.", "$ref": "#/$defs/text" },
        "back": { "$ref": "#/$defs/text" },
        "empty": { "description": "The tray with nothing to ask.", "$ref": "#/$defs/text" }
      }
    },
    "voice": {
      "description": "The composer's toggle for the NPC voices setting.",
      "type": "object",
      "required": ["label", "on", "off"],
      "additionalProperties": false,
      "properties": { "label": { "$ref": "#/$defs/text" }, "on": { "$ref": "#/$defs/text" }, "off": { "$ref": "#/$defs/text" } }
    },
    "activity": {
      "description": "What the thinking orb waits for, in words.",
      "type": "object",
      "required": ["thinking", "streaming", "speaking"],
      "additionalProperties": false,
      "properties": { "thinking": { "$ref": "#/$defs/text" }, "streaming": { "$ref": "#/$defs/text" }, "speaking": { "$ref": "#/$defs/text" } }
    },
    "tags": {
      "description": "Tag on a transcript line by where it comes from; free talk, the window's own talk, goes untagged.",
      "type": "object",
      "required": ["story", "earlier"],
      "additionalProperties": false,
      "properties": { "story": { "$ref": "#/$defs/text" }, "earlier": { "description": "A line said before this conversation.", "$ref": "#/$defs/text" } }
    },
    "notes": {
      "description": "The kicker of a gain set apart in the transcript: an item handed over, a person added to the contacts.",
      "type": "object",
      "required": ["item", "contact"],
      "additionalProperties": false,
      "properties": { "item": { "$ref": "#/$defs/text" }, "contact": { "$ref": "#/$defs/text" } }
    },
    "reveal": {
      "type": "object", "required": ["charactersPerSecond", "complete"], "additionalProperties": false,
      "properties": { "charactersPerSecond": { "type": "number", "minimum": 1, "maximum": 120 }, "complete": { "$ref": "#/$defs/text" } }
    },
    "retry": { "$ref": "#/$defs/text" },
    "leave": { "$ref": "#/$defs/text" },
    "leaveCall": { "description": "End conversation on a phone call.", "$ref": "#/$defs/text" },
    "leaveKey": { "description": "The key shown beside End conversation.", "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "section": {
      "type": "object",
      "required": ["title", "hint"],
      "additionalProperties": false,
      "properties": { "title": { "$ref": "#/$defs/text" }, "hint": { "$ref": "#/$defs/text" } }
    }
  }
}

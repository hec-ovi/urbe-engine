{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conversation panel labels; {name} stands for the person talked to",
  "type": "object",
  "required": ["log", "from", "story", "topics", "choices", "actions", "free", "tags", "retry", "leave"],
  "additionalProperties": false,
  "properties": {
    "log": { "description": "Accessible name of the transcript.", "$ref": "#/$defs/text" },
    "from": {
      "description": "Name over a line by who it is from: the player, or the scene set as a story talk opens.",
      "type": "object",
      "required": ["player", "scene"],
      "additionalProperties": false,
      "properties": { "player": { "$ref": "#/$defs/text" }, "scene": { "$ref": "#/$defs/text" } }
    },
    "story": {
      "type": "object",
      "required": ["kicker", "goal", "stake", "journal"],
      "additionalProperties": false,
      "properties": {
        "kicker": { "$ref": "#/$defs/text" },
        "goal": { "$ref": "#/$defs/text" },
        "stake": { "description": "Label of why the talk matters.", "$ref": "#/$defs/text" },
        "journal": { "$ref": "#/$defs/text" }
      }
    },
    "topics": { "$ref": "#/$defs/section" },
    "choices": {
      "type": "object",
      "required": ["title", "hint", "commits"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "commits": { "description": "Marks a reply that moves the story on.", "$ref": "#/$defs/text" }
      }
    },
    "actions": { "$ref": "#/$defs/section" },
    "free": {
      "type": "object",
      "required": ["title", "hint", "placeholder", "input", "send"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "placeholder": { "$ref": "#/$defs/text" },
        "input": { "description": "Accessible name of the text box.", "$ref": "#/$defs/text" },
        "send": { "description": "Accessible name of the send button.", "$ref": "#/$defs/text" }
      }
    },
    "tags": {
      "description": "Tag on a transcript line by where it comes from.",
      "type": "object",
      "required": ["story", "talk"],
      "additionalProperties": false,
      "properties": { "story": { "$ref": "#/$defs/text" }, "talk": { "$ref": "#/$defs/text" } }
    },
    "retry": { "$ref": "#/$defs/text" },
    "leave": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "section": {
      "type": "object",
      "required": ["title", "hint"],
      "additionalProperties": false,
      "properties": { "title": { "$ref": "#/$defs/text" }, "hint": { "$ref": "#/$defs/text" } }
    }
  }
}

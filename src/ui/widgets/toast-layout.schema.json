{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notice labels: the dismiss button and, per kind of notice, its kicker and the line it reads when the game gives none",
  "type": "object",
  "required": ["dismiss", "kinds"],
  "additionalProperties": false,
  "properties": {
    "dismiss": { "$ref": "#/$defs/text" },
    "kinds": {
      "type": "object",
      "required": ["update", "item", "contact", "companion", "paid", "received", "given"],
      "additionalProperties": false,
      "properties": {
        "update": { "$ref": "#/$defs/kind" },
        "item": { "$ref": "#/$defs/kind" },
        "contact": { "$ref": "#/$defs/kind" },
        "companion": { "$ref": "#/$defs/kind" },
        "paid": { "description": "Credits the player paid out.", "$ref": "#/$defs/kind" },
        "received": { "description": "Credits the player was paid.", "$ref": "#/$defs/kind" },
        "given": { "description": "A thing the player handed to a person.", "$ref": "#/$defs/kind" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "object",
      "required": ["kicker"],
      "additionalProperties": false,
      "properties": { "kicker": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } }
    }
  }
}

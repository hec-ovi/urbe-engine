{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quest log labels; {name} stands for the value the view puts there",
  "type": "object",
  "required": ["title", "key", "eyebrow", "subtitle", "records", "tabs", "list", "kinds", "facts", "empty", "status", "follow", "sections", "step", "endings"],
  "additionalProperties": false,
  "properties": {
    "title": { "description": "Panel title.", "$ref": "#/$defs/text" },
    "key": { "description": "The key that opens the panel.", "$ref": "#/$defs/text" },
    "eyebrow": { "description": "The small line over the title; the game's name follows it.", "$ref": "#/$defs/text" },
    "subtitle": { "$ref": "#/$defs/text" },
    "records": { "description": "How many quests the journal holds, {count}.", "$ref": "#/$defs/text" },
    "tabs": {
      "description": "The two lists: quests still open (available, active, unavailable) and the finished ones (completed, failed).",
      "type": "object",
      "required": ["label", "active", "done"],
      "additionalProperties": false,
      "properties": { "label": { "$ref": "#/$defs/text" }, "active": { "$ref": "#/$defs/text" }, "done": { "$ref": "#/$defs/text" } }
    },
    "list": {
      "type": "object",
      "required": ["label", "hint"],
      "additionalProperties": false,
      "properties": { "label": { "$ref": "#/$defs/text" }, "hint": { "$ref": "#/$defs/text" } }
    },
    "kinds": {
      "description": "The main story's red tag and a side job's yellow mark, by the quest's `kind`.",
      "type": "object",
      "required": ["main", "side"],
      "additionalProperties": false,
      "properties": { "main": { "$ref": "#/$defs/kind" }, "side": { "$ref": "#/$defs/kind" } }
    },
    "facts": {
      "description": "The current objective's person and place under the title.",
      "type": "object",
      "required": ["contact", "place"],
      "additionalProperties": false,
      "properties": { "contact": { "$ref": "#/$defs/text" }, "place": { "$ref": "#/$defs/text" } }
    },
    "empty": {
      "description": "What the list and the detail say with nothing in them.",
      "type": "object",
      "required": ["list", "detail", "done"],
      "additionalProperties": false,
      "properties": { "list": { "$ref": "#/$defs/text" }, "detail": { "$ref": "#/$defs/text" }, "done": { "$ref": "#/$defs/text" } }
    },
    "status": {
      "description": "Badge per quest state.",
      "type": "object",
      "required": ["available", "active", "blocked", "done", "failed"],
      "additionalProperties": false,
      "properties": {
        "available": { "$ref": "#/$defs/text" },
        "active": { "$ref": "#/$defs/text" },
        "blocked": { "$ref": "#/$defs/text" },
        "done": { "$ref": "#/$defs/text" },
        "failed": { "$ref": "#/$defs/text" }
      }
    },
    "follow": {
      "type": "object",
      "required": ["quest", "following", "on", "off", "lead", "leading", "finished"],
      "additionalProperties": false,
      "properties": {
        "quest": { "$ref": "#/$defs/text" },
        "following": { "$ref": "#/$defs/text" },
        "on": { "$ref": "#/$defs/text" },
        "off": { "$ref": "#/$defs/text" },
        "lead": { "$ref": "#/$defs/text" },
        "leading": { "$ref": "#/$defs/text" },
        "finished": { "description": "Where a finished quest's Follow would be.", "$ref": "#/$defs/text" }
      }
    },
    "sections": {
      "description": "`history` takes {count}.",
      "type": "object",
      "required": ["current", "prologue", "premise", "outcome", "history"],
      "additionalProperties": false,
      "properties": {
        "current": { "$ref": "#/$defs/text" },
        "prologue": { "$ref": "#/$defs/text" },
        "premise": { "$ref": "#/$defs/text" },
        "outcome": { "$ref": "#/$defs/text" },
        "history": { "$ref": "#/$defs/text" }
      }
    },
    "step": {
      "description": "`commit` takes {text}, `wait` {label}, `hours` {label}, {start} and {end}.",
      "type": "object",
      "required": ["states", "closed", "cancelled", "commit", "wait", "waitNote", "hours"],
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "object",
          "required": ["active", "locked", "done", "cancelled"],
          "additionalProperties": false,
          "properties": {
            "active": { "$ref": "#/$defs/text" },
            "locked": { "$ref": "#/$defs/text" },
            "done": { "$ref": "#/$defs/text" },
            "cancelled": { "$ref": "#/$defs/text" }
          }
        },
        "closed": { "$ref": "#/$defs/text" },
        "cancelled": { "$ref": "#/$defs/text" },
        "commit": { "$ref": "#/$defs/text" },
        "wait": { "$ref": "#/$defs/text" },
        "waitNote": { "$ref": "#/$defs/text" },
        "hours": { "$ref": "#/$defs/text" }
      }
    },
    "endings": {
      "type": "object",
      "required": ["title", "note", "tracking", "or"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/text" },
        "tracking": { "$ref": "#/$defs/text" },
        "or": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "object",
      "required": ["label", "short"],
      "additionalProperties": false,
      "properties": { "label": { "$ref": "#/$defs/text" }, "short": { "$ref": "#/$defs/text" } }
    }
  }
}

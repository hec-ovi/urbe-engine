{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game menu labels: the dock under an open panel and the free pointer line",
  "type": "object",
  "required": ["entries", "dock", "free"],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "description": "Every dock entry by id: play (the dock's way back to the street) and the panel names.",
      "type": "object",
      "required": ["play", "QUESTS", "MAP", "INVENTORY", "CODEX", "CONTACTS", "SETTINGS", "CONTROLS"],
      "additionalProperties": false,
      "properties": {
        "play": { "$ref": "#/$defs/entry" },
        "QUESTS": { "$ref": "#/$defs/entry" },
        "MAP": { "$ref": "#/$defs/entry" },
        "INVENTORY": { "$ref": "#/$defs/entry" },
        "CODEX": { "$ref": "#/$defs/entry" },
        "CONTACTS": { "$ref": "#/$defs/entry" },
        "SETTINGS": { "$ref": "#/$defs/entry" },
        "CONTROLS": { "$ref": "#/$defs/entry" }
      }
    },
    "dock": {
      "description": "The labelled dock under an open panel: play and the panels, in groups a thin rule parts.",
      "type": "object",
      "required": ["label", "groups"],
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["play", "QUESTS", "MAP", "INVENTORY", "CODEX", "CONTACTS", "SETTINGS", "CONTROLS"] }
          }
        }
      }
    },
    "free": { "description": "Shown while the pointer is free on the street with nothing open.", "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "entry": {
      "type": "object",
      "required": ["label", "detail"],
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "detail": { "$ref": "#/$defs/text" },
        "key": { "description": "The key the game binds to it, shown as a label.", "$ref": "#/$defs/text" }
      }
    }
  }
}

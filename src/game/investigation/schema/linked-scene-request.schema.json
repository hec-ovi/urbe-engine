{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:investigation:linked-scene-request",
  "title": "Evidence over a staged scenery scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sceneId", "questId", "incident", "questBindings", "scenery", "evidenceVisuals", "evidence"],
  "properties": {
    "contractVersion": { "const": "1.2" },
    "sceneId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
    "questId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "summary"],
      "properties": {
        "family": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
        "summary": { "$ref": "urn:urbe:engine:investigation:values#/$defs/text" }
      }
    },
    "questBindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/questBinding" }
    },
    "scenery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId"],
      "properties": { "sceneId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" } }
    },
    "evidenceVisuals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "entityId"],
        "properties": {
          "evidenceId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
          "entityId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/evidence" }
    }
  }
}

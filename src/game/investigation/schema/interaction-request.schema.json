{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:investigation:interaction-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetKey", "action", "state", "focus"],
  "properties": {
    "targetKey": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
    "action": { "enum": ["inspect", "take"] },
    "state": { "$ref": "urn:urbe:engine:investigation:values#/$defs/sceneState" },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "unobstructed", "distanceMeters"],
      "properties": {
        "visible": { "type": "boolean" },
        "unobstructed": { "type": "boolean" },
        "distanceMeters": { "type": "number", "minimum": 0 }
      }
    }
  }
}

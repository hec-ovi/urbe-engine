{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:investigation:scene-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sceneId", "questId", "seed", "incident", "location", "bodies", "props", "decals", "evidence"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "sceneId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
    "questId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "summary"],
      "properties": {
        "family": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
        "summary": { "$ref": "urn:urbe:engine:investigation:values#/$defs/text" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "placeId", "origin", "yawRadians", "width", "depth", "entries", "blockedZones", "receivingSurfaces"],
      "properties": {
        "kind": { "enum": ["interior", "street"] },
        "placeId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
        "origin": { "$ref": "urn:urbe:engine:investigation:values#/$defs/vector3" },
        "yawRadians": { "$ref": "urn:urbe:engine:investigation:values#/$defs/finite" },
        "width": { "type": "number", "minimum": 3, "maximum": 250 },
        "depth": { "type": "number", "minimum": 3, "maximum": 250 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entryId", "position", "clearanceRadius"],
            "properties": {
              "entryId": { "$ref": "urn:urbe:engine:investigation:values#/$defs/id" },
              "position": { "$ref": "urn:urbe:engine:investigation:values#/$defs/vector2" },
              "clearanceRadius": { "type": "number", "minimum": 0.6, "maximum": 5 }
            }
          }
        },
        "blockedZones": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/blocker" }
        },
        "receivingSurfaces": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/surface" }
        }
      }
    },
    "bodies": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/body" }
    },
    "props": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/prop" }
    },
    "decals": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/decal" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "urn:urbe:engine:investigation:values#/$defs/evidence" }
    }
  }
}

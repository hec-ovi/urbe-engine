{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-agents:follow-update",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeMin", "deltaSeconds", "playerPosition"],
  "properties": {
    "timeMin": { "type": "number", "minimum": 0 },
    "deltaSeconds": { "type": "number", "minimum": 0, "maximum": 1 },
    "playerPosition": { "$ref": "urn:urbe:engine:npc-agents:values#/$defs/vec3" }
  }
}

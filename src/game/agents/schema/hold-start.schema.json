{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-agents:hold-start",
  "type": "object",
  "additionalProperties": false,
  "required": ["npcId", "timeMin", "place", "position", "heading"],
  "properties": {
    "npcId": { "type": "string", "minLength": 1 },
    "timeMin": { "type": "number", "minimum": 0 },
    "place": { "$ref": "urn:urbe:engine:npc-agents:values#/$defs/place" },
    "position": { "$ref": "urn:urbe:engine:npc-agents:values#/$defs/vec3" },
    "heading": { "type": "number" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:hydro:water-material",
  "type": "object",
  "required": ["key", "alignment", "tiling", "physical", "variants"],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_-]+$" },
    "alignment": { "const": "tile" },
    "tiling": {
      "type": "object",
      "required": ["worldSize"],
      "properties": {
        "worldSize": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "physical": { "type": "object" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "resolution", "maps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+(:[a-z0-9_-]+)?$" },
          "resolution": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 64, "maximum": 4096 }
          },
          "maps": {
            "type": "object",
            "required": ["basecolor", "normal", "roughness", "metallic"],
            "properties": {
              "basecolor": { "$ref": "#/$defs/map" },
              "normal": { "$ref": "#/$defs/map" },
              "roughness": { "$ref": "#/$defs/map" },
              "metallic": { "$ref": "#/$defs/map" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "map": { "type": "string", "pattern": "^assets/[a-z0-9_/-]+\\.png$" }
  }
}

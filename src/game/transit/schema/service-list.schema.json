{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:transit:service-list",
  "oneOf": [
    { "$ref": "urn:urbe:engine:transit:values#/$defs/errorResult" },
    {
      "type": "object",
      "required": ["ok", "services", "state"],
      "properties": {
        "ok": { "const": true },
        "services": { "type": "array", "items": { "$ref": "urn:urbe:engine:transit:values#/$defs/service" } },
        "state": { "$ref": "urn:urbe:engine:transit:values#/$defs/state" }
      },
      "additionalProperties": false
    }
  ]
}

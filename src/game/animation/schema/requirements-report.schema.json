{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:animation:requirements-report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assetId", "edition", "requiredClips"],
  "properties": {
    "version": { "const": "1" },
    "assetId": { "const": "quaternius-universal-animation-library-pro" },
    "edition": { "const": "Pro" },
    "requiredClips": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

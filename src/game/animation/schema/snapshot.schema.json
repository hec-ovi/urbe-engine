{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:animation:snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actors", "actions"],
  "properties": {
    "version": { "const": "1" },
    "actors": {
      "type": "array",
      "items": { "$ref": "urn:urbe:engine:animation:values#/$defs/actor" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "urn:urbe:engine:animation:values#/$defs/actionState" }
    }
  }
}

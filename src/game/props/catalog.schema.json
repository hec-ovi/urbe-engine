{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "materials",
    "models",
    "detailColors"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.glb$"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size": {
            "$ref": "#/$defs/size"
          }
        },
        "oneOf": [
          {
            "required": [
              "height"
            ]
          },
          {
            "required": [
              "size"
            ]
          }
        ]
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "variant"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "box",
              "crate",
              "pallet",
              "litter",
              "bag",
              "dumpster",
              "container",
              "tree"
            ]
          },
          "asset": {
            "type": "string"
          },
          "shape": {
            "enum": [
              "carton",
              "crate",
              "pallet",
              "paper",
              "can"
            ]
          },
          "size": {
            "$ref": "#/$defs/size"
          },
          "open": {
            "type": "boolean"
          },
          "cargo": {
            "type": "boolean"
          },
          "tints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "shape",
              "size"
            ]
          },
          {
            "required": [
              "asset"
            ]
          }
        ]
      }
    },
    "detailColors": {
      "type": "object",
      "required": [
        "tape",
        "label",
        "ink"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      }
    }
  },
  "$defs": {
    "size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  }
}

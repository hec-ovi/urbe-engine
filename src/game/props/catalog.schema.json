{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "materials",
    "models",
    "detailColors"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.glb$"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size": {
            "$ref": "#/$defs/size"
          }
        },
        "oneOf": [
          {
            "required": [
              "height"
            ]
          },
          {
            "required": [
              "size"
            ]
          }
        ]
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "variant"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "box",
              "crate",
              "pallet",
              "litter",
              "bag",
              "dumpster",
              "container",
              "tree"
            ]
          },
          "asset": {
            "type": "string"
          },
          "shape": {
            "enum": [
              "carton",
              "crate",
              "pallet",
              "paper",
              "can",
              "polymer"
            ]
          },
          "size": {
            "$ref": "#/$defs/size"
          },
          "open": {
            "type": "boolean"
          },
          "cargo": {
            "type": "boolean"
          },
          "tints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            }
          },
          "lid": {
            "enum": [
              "none",
              "sealed",
              "loose"
            ]
          },
          "damage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dent",
              "twist",
              "sag",
              "taper"
            ],
            "properties": {
              "dent": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.12
              },
              "twist": {
                "type": "number",
                "minimum": -0.25,
                "maximum": 0.25
              },
              "sag": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1
              },
              "taper": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.2
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "shape",
              "size"
            ]
          },
          {
            "required": [
              "asset"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "shape"
              ],
              "properties": {
                "shape": {
                  "const": "polymer"
                }
              }
            },
            "then": {
              "required": [
                "lid",
                "damage"
              ]
            }
          }
        ]
      }
    },
    "detailColors": {
      "type": "object",
      "required": [
        "tape",
        "label",
        "ink"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      }
    }
  },
  "$defs": {
    "size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  }
}

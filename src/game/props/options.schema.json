{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replacedModuleOwnerIds": {
      "description": "Atlas module owner IDs whose hardware is constructed by the saved Streets bundle.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "loadAsset": {
      "description": "Function(url) returning Promise<{scene: THREE.Group}>; defaults to GLTFLoader.loadAsync."
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "footprint",
          "bottom",
          "top"
        ],
        "properties": {
          "footprint": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "bottom": {
            "type": "number"
          },
          "top": {
            "type": "number"
          }
        }
      }
    }
  }
}

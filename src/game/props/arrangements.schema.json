{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chance",
    "recipes",
    "variation"
  ],
  "properties": {
    "chance": {
      "type": "object",
      "required": [
        "gap",
        "corner",
        "yard"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sites",
          "slots"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "gap",
                "corner",
                "yard"
              ]
            }
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "models",
                "at"
              ],
              "properties": {
                "models": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "at": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "turn": {
                  "type": "number"
                },
                "on": {
                  "type": "integer",
                  "minimum": 0
                },
                "jitter": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.5
                  }
                },
                "yaw": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3.15
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jitter",
        "yaw"
      ],
      "properties": {
        "jitter": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          }
        },
        "yaw": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.15
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:objective-routes:route-result",
  "type": "object",
  "required": ["destination", "nodeIds", "edgeIds", "path3", "distanceMeters"],
  "properties": {
    "destination": { "$ref": "urn:urbe:engine:objective-routes:route-request#/$defs/destination" },
    "nodeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "edgeIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "path3": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
        "items": false
      }
    },
    "distanceMeters": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:quest-actions:active-objective",
  "oneOf": [
    { "type": "null" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetKey", "questId", "stepId", "kind", "title", "text", "place", "actorIds", "venue", "window", "availability", "guidance"],
      "properties": {
        "targetKey": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
        "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
        "stepId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
        "kind": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/objectiveKind" },
        "title": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
        "text": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
        "place": {
          "oneOf": [
            { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/place" },
            { "type": "null" }
          ]
        },
        "actorIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" }
        },
        "venue": {
          "oneOf": [
            { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
            { "type": "null" }
          ]
        },
        "window": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "days", "startMin", "endMin"],
              "properties": {
                "label": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
                "days": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
                "startMin": { "type": "integer", "minimum": 0, "maximum": 1439 },
                "endMin": { "type": "integer", "minimum": 1, "maximum": 1440 }
              }
            },
            { "type": "null" }
          ]
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "reason": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/unavailableReason" }
          }
        },
        "guidance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["questId", "stepId", "place", "destination"],
              "properties": {
                "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "stepId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "place": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/place" },
                "destination": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "id"],
                  "properties": {
                    "kind": { "enum": ["parcel", "station", "stop"] },
                    "id": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["questId", "stepId", "reason"],
              "properties": {
                "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "stepId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "place": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/place" },
                "reason": { "enum": ["target-unavailable", "district-area", "street-edge", "moving-route"] }
              }
            }
          ]
        }
      }
    }
  ]
}

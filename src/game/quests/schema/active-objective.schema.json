{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:quest-actions:active-objective",
  "oneOf": [
    { "type": "null" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetKey", "questId", "stepId", "kind", "title", "text", "place", "guidance"],
      "properties": {
        "targetKey": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
        "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
        "stepId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
        "kind": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/objectiveKind" },
        "title": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
        "text": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
        "place": {
          "oneOf": [
            { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/place" },
            { "type": "null" }
          ]
        },
        "guidance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["questId", "stepId", "place", "destination"],
              "properties": {
                "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "stepId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "place": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/place" },
                "destination": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "id"],
                  "properties": {
                    "kind": { "enum": ["parcel", "station", "stop"] },
                    "id": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["questId", "stepId", "reason"],
              "properties": {
                "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "stepId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
                "place": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/place" },
                "reason": { "enum": ["target-unavailable", "district-area", "street-edge", "moving-route"] }
              }
            }
          ]
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:quest-actions:values",
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["parcel", "district", "edge", "stop", "route"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "bindingAction": { "enum": ["interact", "secondary-interact"] },
    "action": { "enum": ["take", "read", "inspect", "listen", "steal", "work", "deliver"] },
    "interactionKind": { "enum": ["pickup", "observe", "listen", "steal", "work", "deliver"] },
    "objectiveKind": { "enum": ["talk", "goto", "pickup", "observe", "listen", "steal", "assassinate", "work", "deliver", "investigation", "rescue", "escort", "access", "hacking", "sabotage", "transportation"] },
    "unavailableReason": {
      "enum": [
        "role_dead",
        "not_present",
        "off_duty",
        "missing_item",
        "condition",
        "target_missing"
      ]
    },
    "failureCode": {
      "enum": [
        "unknown_target",
        "wrong_action",
        "unavailable",
        "wrong_place",
        "not_visible",
        "occluded",
        "out_of_reach",
        "runtime_rejected"
      ]
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "quantity", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "quantity": { "type": "integer", "minimum": 1 },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "questlineIds"],
          "properties": {
            "kind": { "enum": ["device", "weapon", "document", "key", "substance", "valuable", "information"] },
            "description": { "$ref": "#/$defs/text" },
            "questlineIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    }
  }
}

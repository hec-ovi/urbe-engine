{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:quest-actions:gameplay-perform",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetKey", "bindingAction", "timeMin"],
  "properties": {
    "targetKey": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
    "bindingAction": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/bindingAction" },
    "timeMin": { "type": "number", "minimum": 0 }
  }
}

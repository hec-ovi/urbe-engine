{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:quest-actions:interaction-result",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "targetKey", "action", "progressed", "message", "completed", "inventory", "worldChanges"],
  "properties": {
    "ok": { "type": "boolean" },
    "targetKey": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
    "action": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/action" },
    "progressed": { "type": "boolean" },
    "message": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
    "code": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/failureCode" },
    "readText": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/text" },
    "completed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questId", "stepIds"],
        "properties": {
          "questId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
          "stepIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" }
          },
          "endingId": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/inventoryItem" }
    },
    "worldChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetKey", "state"],
        "properties": {
          "targetKey": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/id" },
          "state": { "enum": ["collected", "stolen", "delivered"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": {
        "properties": {
          "code": { "$ref": "urn:urbe:engine:quest-actions:values#/$defs/failureCode" }
        },
        "required": ["code"]
      }
    }
  ]
}

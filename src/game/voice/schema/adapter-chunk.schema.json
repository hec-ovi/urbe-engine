{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:adapter-chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "requestId", "segmentIndex", "sequence", "sampleRate", "channels",
    "codec", "frameCount", "byteSize", "sha256", "spanIndex"
  ],
  "properties": {
    "version": { "const": "1" },
    "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "segmentIndex": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "sampleRate": { "type": "integer", "minimum": 8000 },
    "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
    "codec": { "enum": ["pcm_s16le", "wav", "opus"] },
    "frameCount": { "type": "integer", "minimum": 0 },
    "byteSize": { "type": "integer", "minimum": 0 },
    "sha256": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/sha256" },
    "dataBase64": {
      "type": "string",
      "contentEncoding": "base64",
      "contentMediaType": "application/octet-stream"
    },
    "uri": { "type": "string", "minLength": 1 },
    "spanIndex": { "type": "integer", "minimum": 0 }
  },
  "oneOf": [
    {
      "required": ["dataBase64"],
      "properties": { "dataBase64": {}, "uri": false }
    },
    {
      "required": ["uri"],
      "properties": { "uri": {}, "dataBase64": false }
    }
  ]
}

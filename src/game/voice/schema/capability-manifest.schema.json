{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:capability-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "adapterId", "streaming", "cancellable", "maxConcurrent",
    "languages", "engine", "output", "controls"
  ],
  "properties": {
    "version": { "const": "1" },
    "adapterId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "streaming": { "const": true },
    "cancellable": { "const": true },
    "maxConcurrent": { "type": "integer", "minimum": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/language" }
    },
    "engine": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/enginePin" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleRate", "channels", "codec", "codecVersion"],
      "properties": {
        "sampleRate": { "type": "integer", "minimum": 8000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "codec": { "enum": ["pcm_s16le", "wav", "opus"] },
        "codecVersion": { "type": "string", "minLength": 1 }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laugh", "chuckle", "cough", "breath", "sigh", "whisper", "pause_ms", "emotion"
      ],
      "properties": {
        "laugh": { "enum": ["native", "reaction", "unsupported"] },
        "chuckle": { "enum": ["native", "reaction", "unsupported"] },
        "cough": { "enum": ["native", "reaction", "unsupported"] },
        "breath": { "enum": ["native", "reaction", "unsupported"] },
        "sigh": { "enum": ["native", "reaction", "unsupported"] },
        "whisper": { "enum": ["native", "unsupported"] },
        "pause_ms": { "const": "exact-silence" },
        "emotion": { "enum": ["native", "unsupported"] }
      }
    }
  }
}

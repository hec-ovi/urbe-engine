{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:start-result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "status", "priority", "profileDigest", "cacheKey"],
  "properties": {
    "version": { "const": "1" },
    "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "status": { "const": "queued" },
    "priority": { "enum": ["conversation", "nearby", "background"] },
    "profileDigest": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/sha256" },
    "cacheKey": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/sha256" }
  }
}

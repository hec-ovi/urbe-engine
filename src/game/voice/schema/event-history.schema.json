{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:event-history",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "events"],
  "properties": {
    "version": { "const": "1" },
    "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "events": {
      "type": "array",
      "items": { "$ref": "urn:urbe:engine:npc-voice:lifecycle-event" }
    }
  }
}

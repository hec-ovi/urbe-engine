{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:profile-record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profileDigest", "profile"],
  "properties": {
    "version": { "const": "1" },
    "profileDigest": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/sha256" },
    "profile": { "$ref": "urn:urbe:engine:npc-voice:voice-profile" }
  }
}

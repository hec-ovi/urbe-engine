{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:cancel-result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "cancelled", "previousStatus"],
      "properties": {
        "version": { "const": "1" },
        "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
        "cancelled": { "const": true },
        "previousStatus": { "enum": ["queued", "active"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "cancelled", "previousStatus"],
      "properties": {
        "version": { "const": "1" },
        "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
        "cancelled": { "const": false },
        "previousStatus": { "enum": ["completed", "cancelled", "failed", "unknown"] }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:runtime-capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["tts", "stt"],
  "properties": {
    "tts": { "$ref": "urn:urbe:engine:npc-voice:capability-manifest" },
    "stt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "adapterId", "modelRevision", "modelSha256", "runtimeRevision", "mediaTypes", "languages"],
      "properties": {
        "version": { "const": "1" },
        "adapterId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
        "modelRevision": { "type": "string", "minLength": 1 },
        "modelSha256": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/sha256" },
        "runtimeRevision": { "type": "string", "minLength": 1 },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["audio/wav", "audio/webm", "audio/ogg", "audio/mp4"] }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}

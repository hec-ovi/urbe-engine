{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:playback-batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "status", "complete", "nextSequence", "chunks"],
  "properties": {
    "version": { "const": "1" },
    "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "status": { "enum": ["unknown", "queued", "active", "completed", "cancelled", "failed"] },
    "complete": { "type": "boolean" },
    "nextSequence": { "type": "integer", "minimum": -1 },
    "chunks": {
      "type": "array",
      "items": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/audioChunk" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:voice-profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "profileId", "npcId", "revision", "seed", "language", "delivery",
    "reference", "engine", "approvedReactions"
  ],
  "properties": {
    "version": { "const": "1" },
    "profileId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "npcId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "language": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/language" },
    "delivery": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/delivery" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media", "transcript", "provenance", "license", "consent"],
      "properties": {
        "media": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/mediaReference" },
        "transcript": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "creator"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "creator": { "type": "string", "minLength": 1 }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "uri", "allowsVoiceCloning"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "uri": { "type": "string", "minLength": 1 },
            "allowsVoiceCloning": { "const": true }
          }
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["granted", "scope", "grantedBy", "recordedAt"],
          "properties": {
            "granted": { "const": true },
            "scope": { "const": "voice-cloning" },
            "grantedBy": { "type": "string", "minLength": 1 },
            "recordedAt": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "engine": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/enginePin" },
    "approvedReactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "audio"],
        "properties": {
          "control": { "enum": ["laugh", "chuckle", "cough", "breath", "sigh"] },
          "audio": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/audioAsset" }
        }
      }
    }
  }
}

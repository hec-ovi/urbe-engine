{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:npc-voice:adapter-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "requestId", "cacheKey", "segmentIndex", "profileRecord",
    "delivery", "inference", "output", "spans"
  ],
  "properties": {
    "version": { "const": "1" },
    "requestId": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/id" },
    "cacheKey": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/sha256" },
    "segmentIndex": { "type": "integer", "minimum": 0 },
    "profileRecord": { "$ref": "urn:urbe:engine:npc-voice:profile-record" },
    "delivery": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/delivery" },
    "inference": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/inference" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleRate", "channels", "codec", "codecVersion"],
      "properties": {
        "sampleRate": { "type": "integer", "minimum": 8000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
        "codec": { "enum": ["pcm_s16le", "wav", "opus"] },
        "codecVersion": { "type": "string", "minLength": 1 }
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spanIndex", "span"],
        "properties": {
          "spanIndex": { "type": "integer", "minimum": 0 },
          "span": { "$ref": "urn:urbe:engine:npc-voice:values#/$defs/adapterSpan" }
        }
      }
    }
  }
}

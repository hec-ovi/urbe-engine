{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:engine:companion:update-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeMin", "playerPosition", "playerPlaces"],
  "properties": {
    "timeMin": { "$ref": "urn:urbe:engine:companion:values#/$defs/time" },
    "playerPosition": { "$ref": "urn:urbe:engine:companion:values#/$defs/vec3" },
    "playerPlaces": { "$ref": "urn:urbe:engine:companion:values#/$defs/playerPlaces" },
    "busy": { "type": "boolean", "description": "The player has something open that a conversation would cover: a panel, a chooser, a summary or a conversation." }
  }
}
